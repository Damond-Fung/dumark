.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #131316;
  padding: 16rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 12rpx;
}

.meta {
  font-size: 24rpx;
  color: #85827a;
  letter-spacing: 1rpx;
}

.stage {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0c0c0e;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
}

.layer {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: transparent;
}

/* 触摸层在最上方，确保手指涂抹生效 */
.mask {
  z-index: 2;
}

.panel {
  margin-top: 16rpx;
  background: #1b1b20;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 24rpx;
  padding: 20rpx 22rpx 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.row-right {
  display: flex;
  align-items: center;
}

.label {
  font-size: 24rpx;
  color: #85827a;
  width: 96rpx;
  flex-shrink: 0;
}

.seg {
  display: flex;
  background: #24242b;
  border-radius: 14rpx;
  padding: 6rpx;
}

.seg-btn {
  min-width: 104rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #9a978f;
  border-radius: 10rpx;
}

.seg-btn.active {
  background: #ff4f5e;
  color: #fff;
}

.icon-btn {
  margin-left: 16rpx;
  padding: 0 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  color: #c9c6bd;
  background: #24242b;
  border-radius: 14rpx;
}

.slider {
  flex: 1;
  margin: 0 8rpx;
}

.hint {
  display: block;
  padding: 10rpx 4rpx 16rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #8f8c84;
  min-height: 76rpx;
}

.hint.ok {
 color: #3ddc97;
}

.hint.err {
  color: #ff7b86;
}

.actions {
  display: flex;
  gap: 20rpx;
}

.actions .btn {
  flex: 1;
}

.loading {
  position: fixed;
  inset: 0;
  background: rgba(8, 8, 10, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.loading-card {
  width: 520rpx;
  padding: 48rpx 40rpx;
  background: #1b1b20;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 79, 94, 0.2);
  border-top-color: #ff4f5e;
  animation: spin 0.9s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #f2f0ea;
  text-align: center;
}

.bar {
  width: 100%;
  height: 10rpx;
  background: #2c2c34;
  border-radius: 10rpx;
  margin-top: 24rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: #ff4f5e;
  transition: width 0.2s ease;
}

.loading-note {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #77746d;
}
